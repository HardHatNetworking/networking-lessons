lab:
  title: L2 Lesson 2 - VLANs and Trunking
  version: 0.2.2
  description: >-
    Two IOSvL2 switches and four IOSv "PCs" split into VLAN 10 (OFFICE) and
    VLAN 20 (CAMERAS). The SW1-SW2 link starts as dynamic auto on both ends,
    so no trunk forms until you build one. A separate management network
    (VLAN 99, 10.99.99.0/24) connects both switches to an Ubuntu automation
    node with vlan_audit.py preinstalled. Nothing is bridged to your real network.
  notes: |-
    VLAN 10 OFFICE  10.10.10.0/24: PC-A .10 (SW1 Gi0/1), PC-C .30 (SW2 Gi0/1)
    VLAN 20 CAMERAS 10.20.20.0/24: PC-B .20 (SW1 Gi0/2), PC-D .40 (SW2 Gi0/2)
    SW1 Gi0/3 <-> SW2 Gi0/3: dynamic auto on both ends (task 1: no trunk)
    Mgmt subnet: 10.99.99.0/24, VLAN 99
      automation .10   SW1 .11   SW2 .12

    Automation nugget: console into "automation" as student, then
      python3 vlan_audit.py 10.99.99.11 10.99.99.12
    The automation node uses NAT only to download Netmiko on first boot.
nodes:
  - id: n0
    label: SW1
    node_definition: iosvl2
    x: 0
    y: 0
    configuration: |-
      hostname SW1
      no ip domain-lookup
      ip domain-name lab.local
      username admin privilege 15 secret ${lab_password}
      spanning-tree mode rapid-pvst
      vtp mode transparent
      vlan 10
       name OFFICE
      vlan 20
       name CAMERAS
      vlan 99
       name MGMT
      interface GigabitEthernet0/1
       description Host port, OFFICE
       switchport mode access
       switchport access vlan 10
       spanning-tree portfast
      interface GigabitEthernet0/2
       description Host port, CAMERAS
       switchport mode access
       switchport access vlan 20
       spanning-tree portfast
      interface GigabitEthernet0/3
       description To SW2 (lesson task 1: no trunk yet)
       switchport trunk encapsulation dot1q
       switchport mode dynamic auto
      interface GigabitEthernet1/0
       description Management
       switchport mode access
       switchport access vlan 99
       spanning-tree portfast
      interface Vlan99
       ip address 10.99.99.11 255.255.255.0
       no shutdown
      ! IOSvL2 brings Vlan99 up down/down after boot; bounce it once, 90 s in.
      event manager applet BOUNCE-VLAN99
       event timer countdown time 90
       action 1.0 cli command "enable"
       action 2.0 cli command "configure terminal"
       action 3.0 cli command "interface vlan 99"
       action 4.0 cli command "shutdown"
       action 5.0 cli command "no shutdown"
       action 6.0 cli command "end"
       action 7.0 syslog msg "Vlan99 bounced after boot"
      crypto key generate rsa modulus 2048
      ip ssh version 2
      line con 0
       logging synchronous
       exec-timeout 0 0
      line vty 0 4
       login local
       transport input ssh
      end
    interfaces:
      - id: i0
        slot: 0
        label: GigabitEthernet0/0
        type: physical
      - id: i1
        slot: 1
        label: GigabitEthernet0/1
        type: physical
      - id: i2
        slot: 2
        label: GigabitEthernet0/2
        type: physical
      - id: i3
        slot: 3
        label: GigabitEthernet0/3
        type: physical
      - id: i4
        slot: 4
        label: GigabitEthernet1/0
        type: physical
  - id: n1
    label: SW2
    node_definition: iosvl2
    x: 0
    y: 240
    configuration: |-
      hostname SW2
      no ip domain-lookup
      ip domain-name lab.local
      username admin privilege 15 secret ${lab_password}
      spanning-tree mode rapid-pvst
      vtp mode transparent
      vlan 10
       name OFFICE
      vlan 20
       name CAMERAS
      vlan 99
       name MGMT
      interface GigabitEthernet0/1
       description Host port, OFFICE
       switchport mode access
       switchport access vlan 10
       spanning-tree portfast
      interface GigabitEthernet0/2
       description Host port, CAMERAS
       switchport mode access
       switchport access vlan 20
       spanning-tree portfast
      interface GigabitEthernet0/3
       description To SW1 (lesson task 1: no trunk yet)
       switchport trunk encapsulation dot1q
       switchport mode dynamic auto
      interface GigabitEthernet1/0
       description Management
       switchport mode access
       switchport access vlan 99
       spanning-tree portfast
      interface Vlan99
       ip address 10.99.99.12 255.255.255.0
       no shutdown
      ! IOSvL2 brings Vlan99 up down/down after boot; bounce it once, 90 s in.
      event manager applet BOUNCE-VLAN99
       event timer countdown time 90
       action 1.0 cli command "enable"
       action 2.0 cli command "configure terminal"
       action 3.0 cli command "interface vlan 99"
       action 4.0 cli command "shutdown"
       action 5.0 cli command "no shutdown"
       action 6.0 cli command "end"
       action 7.0 syslog msg "Vlan99 bounced after boot"
      crypto key generate rsa modulus 2048
      ip ssh version 2
      line con 0
       logging synchronous
       exec-timeout 0 0
      line vty 0 4
       login local
       transport input ssh
      end
    interfaces:
      - id: i0
        slot: 0
        label: GigabitEthernet0/0
        type: physical
      - id: i1
        slot: 1
        label: GigabitEthernet0/1
        type: physical
      - id: i2
        slot: 2
        label: GigabitEthernet0/2
        type: physical
      - id: i3
        slot: 3
        label: GigabitEthernet0/3
        type: physical
      - id: i4
        slot: 4
        label: GigabitEthernet1/0
        type: physical
  - id: n2
    label: PC-A
    node_definition: iosv
    x: -240
    y: -120
    configuration: |-
      hostname PC-A
      no ip routing
      no ip domain-lookup
      no cdp run
      interface GigabitEthernet0/0
       mac-address 0000.0000.000a
       ip address 10.10.10.10 255.255.255.0
       no shutdown
      line con 0
       logging synchronous
       exec-timeout 0 0
      end
    interfaces:
      - id: i0
        slot: 0
        label: GigabitEthernet0/0
        type: physical
  - id: n3
    label: PC-B
    node_definition: iosv
    x: 240
    y: -120
    configuration: |-
      hostname PC-B
      no ip routing
      no ip domain-lookup
      no cdp run
      interface GigabitEthernet0/0
       mac-address 0000.0000.000b
       ip address 10.20.20.20 255.255.255.0
       no shutdown
      line con 0
       logging synchronous
       exec-timeout 0 0
      end
    interfaces:
      - id: i0
        slot: 0
        label: GigabitEthernet0/0
        type: physical
  - id: n4
    label: PC-C
    node_definition: iosv
    x: -240
    y: 360
    configuration: |-
      hostname PC-C
      no ip routing
      no ip domain-lookup
      no cdp run
      interface GigabitEthernet0/0
       mac-address 0000.0000.000c
       ip address 10.10.10.30 255.255.255.0
       no shutdown
      line con 0
       logging synchronous
       exec-timeout 0 0
      end
    interfaces:
      - id: i0
        slot: 0
        label: GigabitEthernet0/0
        type: physical
  - id: n5
    label: PC-D
    node_definition: iosv
    x: 240
    y: 360
    configuration: |-
      hostname PC-D
      no ip routing
      no ip domain-lookup
      no cdp run
      interface GigabitEthernet0/0
       mac-address 0000.0000.000d
       ip address 10.20.20.40 255.255.255.0
       no shutdown
      line con 0
       logging synchronous
       exec-timeout 0 0
      end
    interfaces:
      - id: i0
        slot: 0
        label: GigabitEthernet0/0
        type: physical
  - id: n6
    label: mgmt-sw
    node_definition: unmanaged_switch
    x: 400
    y: 120
    interfaces:
      - id: i0
        slot: 0
        label: port0
        type: physical
      - id: i1
        slot: 1
        label: port1
        type: physical
      - id: i2
        slot: 2
        label: port2
        type: physical
  - id: n7
    label: automation
    node_definition: ubuntu
    x: 640
    y: 120
    configuration: |-
      #cloud-config
      hostname: automation
      manage_etc_hosts: true
      users:
        - default
        - name: student
          gecos: Lab student
          groups: sudo
          shell: /bin/bash
          sudo: ALL=(ALL) NOPASSWD:ALL
          lock_passwd: false
          plain_text_passwd: ${lab_password}
      ssh_pwauth: true
      package_update: true
      packages:
        - python3-venv
        - python3-pip
      write_files:
        - path: /home/student/vlan_audit.py
          encoding: b64
          content: ${vlan_audit_b64}
          owner: student:student
          permissions: '0755'
          defer: true
        - path: /usr/local/sbin/lab-setup.sh
          permissions: '0755'
          content: |
            #!/bin/bash
            # Second NIC (ens3) is the VLAN 99 management network.
            IF=$(ls /sys/class/net | grep -v '^lo$' | sort | sed -n 2p)
            cat > /etc/netplan/60-mgmt.yaml <<EOF
            network:
              version: 2
              ethernets:
                $IF:
                  addresses: [10.99.99.10/24]
            EOF
            chmod 600 /etc/netplan/60-mgmt.yaml
            netplan apply
            # Python environment with Netmiko (and ntc-templates) for vlan_audit.py.
            # Paramiko 5 dropped the SHA-1 key exchanges that IOSvL2's SSH server
            # needs, so pin it below 5.
            sudo -u student python3 -m venv /home/student/.venv
            sudo -u student /home/student/.venv/bin/pip install --quiet netmiko "paramiko<5"
            cat >> /home/student/.bashrc <<'EOF'
            source ~/.venv/bin/activate
            export NET_USER=admin
            echo "Set the switch password first:  read -s -p 'Password: ' NET_PASS; echo; export NET_PASS"
            EOF
            touch /home/student/.lab-ready
      runcmd:
        - [bash, /usr/local/sbin/lab-setup.sh]
    interfaces:
      - id: i0
        slot: 0
        label: ens2
        type: physical
      - id: i1
        slot: 1
        label: ens3
        type: physical
  - id: n8
    label: internet-nat
    node_definition: external_connector
    x: 880
    y: 120
    configuration: NAT
    interfaces:
      - id: i0
        slot: 0
        label: port
        type: physical
links:
  - id: l0
    n1: n0
    i1: i1
    n2: n2
    i2: i0
  - id: l1
    n1: n0
    i1: i2
    n2: n3
    i2: i0
  - id: l2
    n1: n0
    i1: i3
    n2: n1
    i2: i3
  - id: l3
    n1: n1
    i1: i1
    n2: n4
    i2: i0
  - id: l4
    n1: n1
    i1: i2
    n2: n5
    i2: i0
  - id: l5
    n1: n7
    i1: i0
    n2: n8
    i2: i0
  - id: l6
    n1: n6
    i1: i1
    n2: n0
    i2: i4
  - id: l7
    n1: n6
    i1: i2
    n2: n1
    i2: i4
  - id: l8
    n1: n6
    i1: i0
    n2: n7
    i2: i1
